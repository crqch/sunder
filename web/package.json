{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types && vite build",
    "preview": "bun run build && wrangler dev",
    "prepare": "cd .. && husky ./web/.husky",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "gen": "wrangler types",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "astryx-svelte": "node node_modules/@astryx-sv/cli/bin/astryx-svelte.mjs"
  },
  "dependencies": {
    "@astryx-sv/core": "0.7.14",
    "@astryx-sv/theme-neutral": "0.7.14",
    "@icons-pack/svelte-simple-icons": "^7.2.0",
    "@lucide/svelte": "^1.31.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@stylexjs/stylex": "0.19.2",
    "dexie": "^4.4.4",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "@astryx-sv/cli": "0.7.14",
    "@stylexjs/unplugin": "0.19.2",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@vite-pwa/sveltekit": "^1.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.97.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,yaml,toml,html,css,md,vue,svelte}": "bunx oxfmt",
    "*.{js,ts,jsx,tsx,svelte}": "bunx oxlint"
  },
  "astryx": {
    "theme": "@astryx-sv/theme-neutral"
  }
}
